[user]
	name = InfiniteBlanK3T
	email = applications.clubbed579@passinbox.com

[core]
	editor = nvim
	pager = less -FRX
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[diff]
	colorMoved = zebra

[merge]
	conflictstyle = diff3

[fetch]
	prune = true
